# Conexão com o Postgres.
#
# Supabase: Connect → Connection string → Session pooler (IPv4). Troque [YOUR-PASSWORD].
#   DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-...pooler.supabase.com:5432/postgres
#
# Postgres local (ex.: porta 5433, usuário sem senha):
#   DATABASE_URL=postgresql://usuario@localhost:5433/livraria
DATABASE_URL=
